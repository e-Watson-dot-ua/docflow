# Normalize line endings in the repo; checkout uses platform default
* text=auto

# Force LF for scripts and files consumed by Linux containers
*.sh    text eol=lf
*.bicep text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Dockerfile text eol=lf

# Windows-specific files keep CRLF
*.sln   text eol=crlf
*.slnx  text eol=crlf
*.ps1   text eol=crlf
*.cmd   text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.pdf binary
